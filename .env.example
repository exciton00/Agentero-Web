# Agentero-Web local configuration.
#
#   cp .env.example .env
#   # edit the values below; .env is git-ignored
#
# docker compose reads this file automatically. Never commit .env.
# Values containing '$' (e.g. bcrypt hashes) should be single-quoted.

# --- host paths (created automatically / ignored by git) ---
AGENTERO_VAULT_DIR=./vault
AGENTERO_DATA_DIR=./data

# --- image / build ---
# Default: the image built by GitHub Actions (workflow docker-image.yml).
AGENTERO_IMAGE=ghcr.io/exciton00/agentero-web:latest
# For a local source build instead, use:
# AGENTERO_IMAGE=agentero-web:local
AGENTERO_BUILD_VERSION=dev

# --- web host ---
AGENTERO_WEB_BIND=127.0.0.1
AGENTERO_WEB_PORT=8787
AGENTERO_WEB_ADDR=0.0.0.0:8787
AGENTERO_WEB_VAULT=/vault
AGENTERO_WEB_DIST=/app/dist
AGENTERO_WEB_MAX_BODY_MB=64
# Optional extra roots for the file API (colon or comma separated):
AGENTERO_WEB_ALLOW_ROOTS=

# --- MCP (optional; no auth of its own, put it behind a proxy) ---
# Set AGENTERO_MCP_ENABLED=1 to start the listener even when the Settings
# toggle is off. In containers bind to 0.0.0.0 and publish 8765 (uncomment the
# port mapping in docker-compose.yml). Add the public host to ALLOWED_HOSTS.
AGENTERO_MCP_ENABLED=
AGENTERO_MCP_BIND=
AGENTERO_MCP_PORT=8765
AGENTERO_MCP_ALLOWED_HOSTS=
# Optional production MCP public hostname (uncomment the MCP block in deploy/Caddyfile):
# AGENTERO_MCP_DOMAIN=mcp.example.com

# --- optional agent CLI credentials (server-side) ---
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- optional cloud-sync credentials (otherwise use Settings/XDG sync.json) ---
AGENTERO_SYNC_ACCESS_KEY=
AGENTERO_SYNC_SECRET_KEY=

# --- logging ---
RUST_LOG=info

# --- production only (docker-compose.prod.yml / deploy/Caddyfile) ---
# Domain served by Caddy (DNS must point here; ports 80/443 reachable):
AGENTERO_DOMAIN=agentero.example.com
# basic auth user and bcrypt hash. Generate the hash with:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'your-password'
# Keep the hash single-quoted so '$' is not treated as interpolation.
AGENTERO_BASIC_AUTH_USER=you
AGENTERO_BASIC_AUTH_HASH='$2a$14$REPLACE_WITH_BCRYPT_HASH'
