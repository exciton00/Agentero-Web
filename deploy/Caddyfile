# Reverse proxy for the headless Agentero web host.
#
# The app itself has no built-in auth (single-user, trusted network model), so
# this layer owns TLS + authentication. Everything user-specific comes from
# .env (see .env.example):
#
#   AGENTERO_DOMAIN             # public hostname; DNS must point here
#   AGENTERO_BASIC_AUTH_USER    # login user
#   AGENTERO_BASIC_AUTH_HASH    # bcrypt hash, single-quoted in .env
#
# Generate the hash with:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'your-password'
#
# Start with:
#   docker compose -f docker-compose.prod.yml up -d

{$AGENTERO_DOMAIN} {
	encode zstd gzip

	basic_auth {
		{$AGENTERO_BASIC_AUTH_USER} {$AGENTERO_BASIC_AUTH_HASH}
	}

	# The app is served from one origin; no CORS needed.
	reverse_proxy agentero-web:8787 {
		# WebSocket upgrade for /api/events (streaming, watcher, job progress).
		header_up X-Forwarded-Proto {scheme}
	}

	# Large PDFs / attachments: allow big request bodies (uploads).
	request_body {
		max_size 512MB
	}
}

# Optional MCP route: expose 8765 in docker-compose.prod.yml, uncomment this
# block, and add AGENTERO_MCP_DOMAIN to .env. The MCP endpoint has no auth of
# its own, so it sits behind the same basic auth.
# {$AGENTERO_MCP_DOMAIN} {
# 	encode zstd gzip
# 	basic_auth {
# 		{$AGENTERO_BASIC_AUTH_USER} {$AGENTERO_BASIC_AUTH_HASH}
# 	}
# 	reverse_proxy agentero-web:8765
# }
