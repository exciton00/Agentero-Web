# Optional override: let the Agentero-Web container run the ACP agent that is
# already installed and authenticated on the Docker host.
#
# The web host auto-detects the mounted Dsh entry below and registers it as a
# "Host Dsh" agent at startup, so no manual Settings -> Agent step is needed.
#
# Easiest: run `./scripts/docker-up.sh` (it detects the host Dsh and generates
# this override for you). Manual usage:
#   cp docker-compose.host-agent.yml.example docker-compose.host-agent.yml
#   docker compose -f docker-compose.yml -f docker-compose.host-agent.yml up -d
#
# The host's Vault path can be mirrored into the container by setting
# AGENTERO_VAULT_CONTAINER_PATH to the same absolute path as AGENTERO_VAULT_DIR
# (see .env.example), e.g. both /srv/agentero/vault.

services:
  agentero-web:
    volumes:
      # Host's global Dsh package (adjust for nvm/volta/custom prefixes):
      - ${AGENTERO_HOST_DSH_PKG:-/usr/lib/node_modules/@deepseek-ai}:/opt/host-agent/@deepseek-ai:ro
      # Host's configured Dsh home (credentials + acp profile):
      - ${AGENTERO_DSH_HOME:-${HOME}/.dsh}:/data/home/.dsh
