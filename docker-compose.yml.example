# Agentero-Web — one compose file; no reverse proxy or production profile.
#
# QUICK START
#   1. cp docker-compose.yml.example docker-compose.yml
#   2. cp .env.example .env
#   3. mkdir -p vault data
#   4. docker compose pull
#   5. docker compose up -d        # http://127.0.0.1:8787
#
# Reverse proxy / TLS / authentication is intentionally NOT provided here.
# If you expose this beyond localhost, bring your own proxy and make sure it
# supports WebSocket for /api/events.
#
# HOST DSH AGENT (required for Agent chat)
# The image does not contain an agent CLI. To use the Dsh installed on this
# Linux host, compose bind-mounts:
#   1. the host global Dsh package root (read-only)
#   2. the host ~/.dsh directory (credentials + profiles; read-write)
# The Web host registers the normal Dsh catalog row at startup.
# The defaults match a system npm global install as root:
#   AGENTERO_HOST_DSH_ROOT=/usr/lib/node_modules/@deepseek-ai
#   AGENTERO_DSH_HOME=/root/.dsh
# If `readlink -f "$(command -v dsh)"` points elsewhere, set both paths in .env.
# Reusing an old ./data volume may keep a stale auto-registration marker: use
# Settings -> Agent -> "Detect host Dsh" -> "Redetect" to clear it.
#
# The real docker-compose.yml and .env are git-ignored.

services:
  agentero-web:
    build:
      context: .
      args:
        AGENTERO_BUILD_VERSION: ${AGENTERO_BUILD_VERSION:-dev}
    image: ${AGENTERO_IMAGE:-ghcr.io/exciton00/agentero-web:latest}
    container_name: agentero-web
    restart: unless-stopped
    ports:
      # No built-in auth: keep this loopback and put your own proxy in front if
      # you need remote access.
      - "${AGENTERO_WEB_BIND:-127.0.0.1}:${AGENTERO_WEB_PORT:-8787}:8787"
      # Optional MCP port: uncomment with AGENTERO_MCP_ENABLED/BIND in .env.
      # - "${AGENTERO_MCP_PORT:-8765}:${AGENTERO_MCP_PORT:-8765}"
    environment:
      AGENTERO_WEB_ADDR: ${AGENTERO_WEB_ADDR:-0.0.0.0:8787}
      AGENTERO_WEB_VAULT: ${AGENTERO_VAULT_CONTAINER_PATH:-/vault}
      AGENTERO_WEB_DIST: ${AGENTERO_WEB_DIST:-/app/dist}
      AGENTERO_WEB_MAX_BODY_MB: ${AGENTERO_WEB_MAX_BODY_MB:-64}
      AGENTERO_WEB_ALLOW_ROOTS: ${AGENTERO_WEB_ALLOW_ROOTS:-}
      RUST_LOG: ${RUST_LOG:-info}
      AGENTERO_MCP_ENABLED: ${AGENTERO_MCP_ENABLED:-}
      AGENTERO_MCP_BIND: ${AGENTERO_MCP_BIND:-}
      AGENTERO_MCP_ALLOWED_HOSTS: ${AGENTERO_MCP_ALLOWED_HOSTS:-}
      AGENTERO_SYNC_ACCESS_KEY: ${AGENTERO_SYNC_ACCESS_KEY:-}
      AGENTERO_SYNC_SECRET_KEY: ${AGENTERO_SYNC_SECRET_KEY:-}
      DEEPSEEK_API_KEY: ${DEEPSEEK_API_KEY:-}
      ANTHROPIC_API_KEY: ${ANTHROPIC_API_KEY:-}
      OPENAI_API_KEY: ${OPENAI_API_KEY:-}
      # The image defaults to Dsh's danger-full-access preset because Docker's
      # default seccomp profile cannot create bwrap namespaces. To keep Dsh's
      # workspace-write sandbox instead, set this to workspace-write and add:
      #   cap_add: [SYS_ADMIN]
      #   security_opt: ["seccomp=unconfined"]
      DSH_PERMISSION_MODE: ${DSH_PERMISSION_MODE:-danger-full-access}
    volumes:
      - ${AGENTERO_VAULT_DIR:-./vault}:${AGENTERO_VAULT_CONTAINER_PATH:-/vault}
      - ${AGENTERO_DATA_DIR:-./data}:/data
      # Host Dsh package: the image runs it with its own Node 22.
      - ${AGENTERO_HOST_DSH_ROOT:-/usr/lib/node_modules/@deepseek-ai}:/opt/host-agent/@deepseek-ai:ro
      # Host Dsh config: credentials + profiles (read-write for sessions/logs).
      - ${AGENTERO_DSH_HOME:-${HOME}/.dsh}:/data/home/.dsh
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
