# Agentero-Web — single compose file for local + production.
#
# QUICK START
#   1. cp docker-compose.yml.example docker-compose.yml
#   2. cp .env.example .env          # edit paths/ports/prod fields
#   3. mkdir -p vault data
#   4. docker compose pull
#   5. docker compose up -d          # open http://127.0.0.1:8787
#
# PRODUCTION (same file; Caddy lives behind the `prod` profile)
#   - in .env set AGENTERO_DOMAIN / AGENTERO_BASIC_AUTH_USER / AGENTERO_BASIC_AUTH_HASH
#   - docker compose --profile prod pull
#   - docker compose --profile prod up -d
#   The app port stays bound to loopback; Caddy owns 80/443.
#
# AGENT (Dsh)
#   The image bundles the tested `dsh` CLI. The app only needs the host ~/.dsh
#   config mounted at /data/home/.dsh (default: ${HOME}/.dsh; override with
#   AGENTERO_DSH_HOME in .env). The Web host auto-registers the normal Dsh
#   catalog row at startup — no host-agent/host-prod compose file is needed.
#
# The real docker-compose.yml and .env are git-ignored.

services:
  agentero-web:
    build:
      context: .
      args:
        AGENTERO_BUILD_VERSION: ${AGENTERO_BUILD_VERSION:-dev}
    image: ${AGENTERO_IMAGE:-ghcr.io/exciton00/agentero-web:latest}
    container_name: agentero-web
    restart: unless-stopped
    ports:
      # Keep loopback unless a reverse proxy (Caddy profile / your own proxy)
      # is in front. Single-user app with no built-in auth.
      - "${AGENTERO_WEB_BIND:-127.0.0.1}:${AGENTERO_WEB_PORT:-8787}:8787"
      # Optional MCP endpoint (no auth of its own): uncomment and set the
      # MCP variables in .env to publish it.
      # - "${AGENTERO_MCP_PORT:-8765}:${AGENTERO_MCP_PORT:-8765}"
    environment:
      AGENTERO_WEB_ADDR: ${AGENTERO_WEB_ADDR:-0.0.0.0:8787}
      AGENTERO_WEB_VAULT: ${AGENTERO_VAULT_CONTAINER_PATH:-/vault}
      AGENTERO_WEB_DIST: ${AGENTERO_WEB_DIST:-/app/dist}
      AGENTERO_WEB_MAX_BODY_MB: ${AGENTERO_WEB_MAX_BODY_MB:-64}
      AGENTERO_WEB_ALLOW_ROOTS: ${AGENTERO_WEB_ALLOW_ROOTS:-}
      RUST_LOG: ${RUST_LOG:-info}
      AGENTERO_MCP_ENABLED: ${AGENTERO_MCP_ENABLED:-}
      AGENTERO_MCP_BIND: ${AGENTERO_MCP_BIND:-}
      AGENTERO_MCP_ALLOWED_HOSTS: ${AGENTERO_MCP_ALLOWED_HOSTS:-}
      AGENTERO_SYNC_ACCESS_KEY: ${AGENTERO_SYNC_ACCESS_KEY:-}
      AGENTERO_SYNC_SECRET_KEY: ${AGENTERO_SYNC_SECRET_KEY:-}
      DEEPSEEK_API_KEY: ${DEEPSEEK_API_KEY:-}
      ANTHROPIC_API_KEY: ${ANTHROPIC_API_KEY:-}
      OPENAI_API_KEY: ${OPENAI_API_KEY:-}
    volumes:
      - ${AGENTERO_VAULT_DIR:-./vault}:${AGENTERO_VAULT_CONTAINER_PATH:-/vault}
      - ${AGENTERO_DATA_DIR:-./data}:/data
      # Host Dsh config (credentials + profiles). The image already contains the
      # tested Dsh CLI, so a host Dsh installation only needs its ~/.dsh mounted
      # here; the agent is auto-registered at startup. Override the source for
      # Windows/custom homes with AGENTERO_DSH_HOME in .env.
      - ${AGENTERO_DSH_HOME:-${HOME}/.dsh}:/data/home/.dsh
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

  # Production-only reverse proxy. Enabled with `--profile prod`.
  # Domain + basic-auth hash come from .env; deploy/Caddyfile is generic.
  caddy:
    profiles: ["prod"]
    image: caddy:2
    container_name: agentero-caddy
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
    environment:
      AGENTERO_DOMAIN: ${AGENTERO_DOMAIN}
      AGENTERO_BASIC_AUTH_USER: ${AGENTERO_BASIC_AUTH_USER}
      AGENTERO_BASIC_AUTH_HASH: ${AGENTERO_BASIC_AUTH_HASH}
      AGENTERO_MCP_DOMAIN: ${AGENTERO_MCP_DOMAIN:-}
    volumes:
      - ./deploy/Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy_data:/data
      - caddy_config:/config
    depends_on:
      - agentero-web

volumes:
  caddy_data:
  caddy_config:
